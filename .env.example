# Copy to .env and fill in. `.env` is git-ignored.
# NOTE: Circle Agent Wallets need NO API key — the session comes from
#       `circle wallet login <email> --testnet` (email OTP, stored in your OS keychain, 28 days).

# Chain the agent pays on. Testnet for the hackathon; ARC for mainnet.
GUARDIAN_CHAIN=ARC-TESTNET

# Treasury agent wallet address (from: circle wallet list --chain ARC-TESTNET --type agent)
GUARDIAN_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Policy file and ledger location
GUARDIAN_POLICY=./policy.yaml
GUARDIAN_LEDGER=./data/guardian.ledger.jsonl

# Arc RPC with your token, written by `arc-canteen login` to ~/.arc-canteen/env as $RPC.
# Only needed for direct JSON-RPC reads (balances, receipts). Leave empty to skip.
ARC_RPC_URL=

# LLM key for the reference AP agent (invoice extraction). Not needed by the Guardian core.
ANTHROPIC_API_KEY=
